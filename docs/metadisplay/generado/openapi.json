				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateDisplayInput"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Creada con la plantilla «inicio»",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Display"
								}
							}
						}
					},
					"400": {
						"description": "Cuerpo inválido",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					},
					"401": {
						"description": "Sin sesión ni token válido",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					},
					"409": {
						"description": "Ya existe una pantalla con ese deviceId",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
