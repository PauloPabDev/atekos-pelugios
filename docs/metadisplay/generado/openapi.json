				"responses": {
					"200": {
						"description": "AsyncAPI 3.0"
					}
				}
			}
		},
		"/contract/openapi.json": {
			"get": {
				"summary": "Este documento",
				"security": [],
				"responses": {
					"200": {
						"description": "OpenAPI 3.1"
					}
				}
			}
		},
