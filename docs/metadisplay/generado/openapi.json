										"$ref": "#/components/schemas/Display"
									}
								}
							}
						}
					},
					"401": {
						"description": "Sin sesión ni token válido",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
					},
					"404": {
						"description": "Pantalla ajena, inexistente o deviceId mal formado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ApiError"
								}
							}
						}
