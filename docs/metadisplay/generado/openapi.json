	"components": {
		"securitySchemes": {
			"session": {
				"type": "apiKey",
				"in": "cookie",
				"name": "sid",
				"description": "Sesión de la web"
			},
			"token": {
				"type": "http",
				"scheme": "bearer",
				"description": "Token dmt_ con displays:write (si está ligado, solo para su pantalla)"
			}
		},
		"schemas": {
			"ApiError": {
				"type": "object",
				"properties": {
					"error": {
						"type": "string"
					},
					"message": {
						"type": "string"
					},
					"issues": {}
				},
				"required": [
					"error"
				]
			},
			"CreateDisplayInput": {
				"type": "object",
				"properties": {
