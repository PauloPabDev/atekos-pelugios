{
	"openapi": "3.1.0",
	"info": {
		"title": "MetaDisplay en atekos-pelugios: API REST",
		"version": "1.0.0",
		"description": "Administración de pantallas, plantillas y datos. El dispositivo no la usa: habla solo por WSS /ws/device (ver asyncapi.json). Errores: { error, message?, issues? }.",
