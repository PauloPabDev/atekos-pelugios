{$DOMAIN} {
	encode zstd gzip
	header -Server

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /ws {
		reverse_proxy api:3000
	}
	# /ws es coincidencia exacta: el WSS de las pantallas MetaDisplay necesita su propia ruta.
	handle /ws/device {
		reverse_proxy api:3000
	}
	# Descubrimiento OAuth del MCP (RFC 8414 y RFC 9728): tiene que estar en la raíz del dominio (docs/MCP.md).
	handle /.well-known/oauth-* {
		reverse_proxy api:3000
	}
	handle {
		# Nadie puede enmarcar la web: protege la pantalla de consentimiento OAuth del clickjacking.
		header X-Frame-Options DENY
		header Content-Security-Policy "frame-ancestors 'none'"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Opcional: HTTP sin TLS solo para dispositivos de la LAN (ESP8266). El token sigue siendo obligatorio.
# Publica "8081:8081" en compose.prod.yml para usarlo.
http://:8081 {
	@lan remote_ip private_ranges
	handle @lan {
		reverse_proxy api:3000
	}
	respond 403
}
