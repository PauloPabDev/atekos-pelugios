# Genera las contraseñas con: openssl rand -hex 24  (hex: sin caracteres que haya que escapar en URLs)
POSTGRES_USER=atekos
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=domotica
MONGO_USER=atekos
MONGO_PASSWORD=cambia-esto
REDIS_PASSWORD=cambia-esto
# openssl rand -base64 48
TOKEN_PEPPER=cambia-esto-por-al-menos-32-caracteres-aleatorios
# localhost en dev; tu dominio en prod (Caddy saca el certificado solo)
DOMAIN=localhost
# URL pública con la que la IA llega al MCP (issuer OAuth). En prod compose ya usa https://$DOMAIN; sin ella no hay MCP.
PUBLIC_URL=http://localhost:8080
# Tope en bytes de una plantilla o mensaje a una pantalla MetaDisplay (1 MB por defecto). La flash LittleFS de la
# pantalla es de 1,875 MB y guarda la plantilla más una copia temporal al escribirla: no pases de ~900000 si la usa.
# DISPLAY_MAX_TEMPLATE_BYTES=1048576
# Puertos del host en dev (los estándar suelen estar ocupados por otros proyectos)
PG_PORT=15432
MONGO_PORT=27018
REDIS_PORT=16379
